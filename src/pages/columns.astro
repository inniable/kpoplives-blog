---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const columnPosts = (await getCollection('posts', ({ data }) => data.category === 'column')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="English Columns">
  <section class="archive-section">
    <div class="container">
      <div class="archive-header">
        <span class="badge badge--column">
          <span class="lang-en">English Columns</span>
          <span class="lang-ko">영문 칼럼</span>
          <span class="lang-jp">英語コラム</span>
          <span class="lang-es">Columnas</span>
        </span>
        <h1 class="archive-title">
          <span class="lang-en">Deep-Dive Essays & Criticism</span>
          <span class="lang-ko">심층 영문 칼럼 & 음악 비평</span>
          <span class="lang-jp">深掘り英語コラム＆音楽批評</span>
          <span class="lang-es">Ensayos y Crítica Cultural</span>
        </h1>
        <p class="archive-desc">
          <span class="lang-en">Long-form English commentary exploring K-Pop production trends, fandom culture, and global pop aesthetics.</span>
          <span class="lang-ko">K-POP 사운드 트렌드, 팬덤 문화, 글로벌 음악 산업을 깊이 있게 분석하는 영문 칼럼 아카이브입니다.</span>
          <span class="lang-jp">K-POPのサウンドトレンド、ファンダム文化、グローバル音楽シーンを深く読み解く英語コラム集です。</span>
          <span class="lang-es">Ensayos en profundidad sobre producción musical, cultura fandom y estética global del K-Pop.</span>
        </p>
      </div>

      <div class="posts-grid">
        {columnPosts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .archive-section {
    padding: 56px 0 24px;
  }

  .archive-header {
    max-width: 680px;
    margin-bottom: 40px;
  }

  .archive-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.15;
    margin: 14px 0 12px;
    letter-spacing: -0.025em;
  }

  .archive-desc {
    color: var(--text-secondary);
    font-size: 1.02rem;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 980px) {
    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
