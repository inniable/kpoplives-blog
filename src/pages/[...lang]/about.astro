---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang, LANG_STATIC_PATHS, localizePath } from '../../utils/i18n';

export function getStaticPaths() {
  return LANG_STATIC_PATHS;
}

const { lang } = Astro.props as { lang: Lang };

const titles: Record<Lang, string> = {
  en: 'About KPOP LIVES',
  ko: 'KPOP LIVES 소개',
  jp: 'KPOP LIVES について',
  es: 'Acerca de KPOP LIVES',
};

const headlines: Record<Lang, string> = {
  en: 'Independent K-Pop Journalism, Written for the World.',
  ko: '글로벌 팬들을 위한 독립 K-POP 뉴스 & 문화 비평 매거진',
  jp: '世界のファンへ届ける独立系K-POPニュース＆カルチャーメディア',
  es: 'Periodismo independiente de K-Pop para lectores de todo el mundo.',
};

const leads: Record<Lang, string> = {
  en: 'KPOP LIVES delivers breaking K-Pop news, chart analysis, and thoughtful cultural criticism across four native-grade editions: English, Korean, Japanese, and Spanish.',
  ko: 'KPOP LIVES는 최신 K-POP 뉴스와 글로벌 차트 분석, 음악 프로덕션 비평을 영어·한국어·일본어·스페인어 4개 국어 에디션으로 전하는 독립 온라인 매거진입니다.',
  jp: 'KPOP LIVESは、最新のK-POPニュース、グローバルチャート分析、音楽プロダクション批評を英語・韓国語・日本語・スペイン語の4言語でお届けする独立系オンラインマガジンです。',
  es: 'KPOP LIVES ofrece noticias de última hora, análisis de listas globales y crítica cultural de K-Pop en cuatro ediciones: inglés, coreano, japonés y español.',
};
---

<BaseLayout title={titles[lang]} description={leads[lang]} lang={lang}>
  <section class="page-section container">
    <span class="section-eyebrow">ABOUT KPOP LIVES</span>
    <h1 class="page-title">{headlines[lang]}</h1>
    <p class="page-lead">{leads[lang]}</p>

    <div class="card prose">
      {lang === 'ko' ? (
        <>
          <h2>우리가 다루는 이야기</h2>
          <ul>
            <li><strong>글로벌 K-POP 뉴스:</strong> 컴백 소식, 빌보드·스포티파이 글로벌 차트 성과, 월드 투어 일정 등 핵심 이슈를 정확하고 빠르게 전합니다.</li>
            <li><strong>심층 영문 칼럼 &amp; 음악 비평:</strong> 5세대 사운드 트렌드, 송캠프 프로덕션, 팬덤 문화, 글로벌 공연 산업을 깊이 있게 분석합니다.</li>
            <li><strong>4개 국어 현지화 에디션:</strong> 전 세계 독자들이 자연스럽게 읽을 수 있도록 영어(EN)·한국어(KR)·일본어(JP)·스페인어(ES) 전용 페이지를 제공합니다.</li>
          </ul>

          <h2>편집 원칙</h2>
          <p>모든 기사는 공식 기획사 발표, 공식 채널, 공인 차트 데이터를 기반으로 사실 확인을 거쳐 발행하며, 아티스트와 저작권자의 권리를 존중합니다.</p>
          <p>제보, 협업, 문의 사항은 <a href={localizePath(lang, '/contact')}>문의하기 페이지</a>를 통해 편하게 연락해 주세요.</p>
        </>
      ) : lang === 'jp' ? (
        <>
          <h2>私たちが届けるコンテンツ</h2>
          <ul>
            <li><strong>グローバルK-POPニュース：</strong> カムバック情報、ビルボードやSpotifyのチャート記録、ワールドツアー日程を正確かつスピーディーにお伝えします。</li>
            <li><strong>深掘りコラム＆音楽批評：</strong> 第5世代サウンドの進化、ソングキャンプ制作背景、ファンダム文化、ライブ市場の潮流を多角的に分析します。</li>
            <li><strong>4言語ネイティブ版：</strong> 世界中の読者が自然に楽しめるよう、英語・韓国語・日本語・スペイン語の専用エディションを展開しています。</li>
          </ul>

          <h2>編集方針</h2>
          <p>すべての記事は公式発表・公式チャンネル・公認チャートデータに基づいて執筆し、アーティストと著作権者の権利を尊重しています。お問い合わせは<a href={localizePath(lang, '/contact')}>お問い合わせページ</a>よりご連絡ください。</p>
        </>
      ) : lang === 'es' ? (
        <>
          <h2>Qué cubrimos</h2>
          <ul>
            <li><strong>Noticias globales de K-Pop:</strong> Comebacks, récords en Billboard y Spotify, y anuncios de giras mundiales verificados al momento.</li>
            <li><strong>Columnas y crítica cultural:</strong> Ensayos en profundidad sobre producción musical, song camps, cultura fandom y la evolución de la industria en vivo.</li>
            <li><strong>Cuatro ediciones internacionales:</strong> Contenido dedicado en inglés, coreano, japonés y español pensado para lectores de todo el mundo.</li>
          </ul>

          <h2>Estándares editoriales</h2>
          <p>Cada artículo se verifica con fuentes oficiales, sellos discográficos y listas reconocidas, respetando estrictamente los derechos de autor. Puedes escribirnos desde nuestra <a href={localizePath(lang, '/contact')}>página de contacto</a>.</p>
        </>
      ) : (
        <>
          <h2>What We Cover</h2>
          <ul>
            <li><strong>Global K-Pop News:</strong> Verified updates on major comebacks, Billboard and Spotify chart milestones, and international stadium tours.</li>
            <li><strong>Deep-Dive Cultural Columns:</strong> Sharp criticism examining 5th-generation production shifts, Seoul song camps, fandom culture, and the global live music economy.</li>
            <li><strong>Four Native Editions:</strong> Dedicated English, Korean, Japanese, and Spanish editions tailored for K-Pop readers worldwide.</li>
          </ul>

          <h2>Our Editorial Commitment</h2>
          <p>Every dispatch is fact-checked against official agency statements, verified channels, and recognized chart providers, while strictly respecting artist and media copyrights.</p>
          <p>For press releases, pitches, or inquiries, please visit our <a href={localizePath(lang, '/contact')}>Contact page</a>.</p>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-section {
    padding: 56px 0 24px;
    max-width: 860px;
  }
  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.15;
    margin: 10px 0 16px;
  }
  .page-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 36px;
  }
  .card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
  }
  .card h2:first-child {
    margin-top: 0;
  }
</style>
