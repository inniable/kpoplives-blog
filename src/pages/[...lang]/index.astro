---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import {
  type Lang,
  LANG_STATIC_PATHS,
  UI,
  getPostLocalized,
  localizePath,
} from '../../utils/i18n';

export function getStaticPaths() {
  return LANG_STATIC_PATHS;
}

const { lang } = Astro.props as { lang: Lang };
const t = UI[lang];

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const featuredLoc = featuredPost ? getPostLocalized(featuredPost, lang) : null;
const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags))).slice(0, 8);

const searchCopy: Record<Lang, { placeholder: string; empty: string; loadMore: string }> = {
  en: { placeholder: 'Search artists, albums, or topics...', empty: 'No matching stories found.', loadMore: 'Load More Stories' },
  ko: { placeholder: '아티스트, 앨범, 키워드로 검색...', empty: '검색 결과가 없습니다.', loadMore: '기사 더 보기' },
  jp: { placeholder: 'アーティスト・アルバム・キーワードで検索...', empty: '該当する記事が見つかりませんでした。', loadMore: 'さらに記事を見る' },
  es: { placeholder: 'Buscar artistas, álbumes o temas...', empty: 'No se encontraron artículos.', loadMore: 'Cargar más artículos' },
};
const sc = searchCopy[lang];
---

<BaseLayout title="KPOP LIVES" lang={lang}>
  <!-- Live Ticker Strip -->
  <div class="ticker-bar">
    <div class="container ticker-inner">
      <span class="ticker-label">
        <span class="pulse-dot"></span>
        <span>{t.home.onAir}</span>
      </span>
      <div class="ticker-items">
        {allPosts.slice(0, 3).map((post) => {
          const loc = getPostLocalized(post, lang);
          return (
            <a href={localizePath(lang, `/posts/${post.id}`)} class="ticker-link">
              {loc.title}
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-intro">
        <span class="section-eyebrow">{t.home.eyebrow}</span>
        <h1 class="hero-headline">
          {t.home.headlinePre}<span class="gradient-text">{t.home.headlineAccent}</span>
        </h1>
      </div>

      {featuredPost && featuredLoc && (
        <a href={localizePath(lang, `/posts/${featuredPost.id}`)} class="featured-card">
          <div class="featured-media">
            <img
              src={featuredPost.data.coverImage}
              alt={featuredPost.data.coverAlt || featuredLoc.title}
              width="1280"
              height="720"
              fetchpriority="high"
              decoding="async"
            />
            <div class="featured-gradient"></div>
          </div>
          <div class="featured-content">
            <div class="featured-badges">
              <span class="badge badge--featured">{t.home.featured}</span>
              <span class:list={['badge', `badge--${featuredPost.data.category}`]}>
                {featuredPost.data.category === 'news' ? t.badges.news : t.badges.column}
              </span>
            </div>

            <h2 class="featured-title">{featuredLoc.title}</h2>
            <p class="featured-desc">{featuredLoc.description}</p>

            <div class="featured-meta">
              <span>{featuredPost.data.author}</span>
              <span>•</span>
              <span>{featuredLoc.readTime}</span>
              <span class="featured-cta">{t.home.readStory}</span>
            </div>
          </div>
        </a>
      )}
    </div>
  </section>

  <!-- Optional AdSense Slot (auto-hidden until PUBLIC_ADSENSE_CLIENT is configured) -->
  <div class="container">
    <AdSlot format="horizontal" />
  </div>

  <!-- Latest Feed with Interactive Filter -->
  <section class="feed-section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="section-eyebrow">{t.home.latestEyebrow}</span>
          <h2 class="section-title">{t.home.latestTitle}</h2>
        </div>

        <div class="filter-bar" role="group" aria-label="Filter stories">
          <button type="button" class="filter-pill is-active" data-filter="all">
            {t.home.all}
          </button>
          <button type="button" class="filter-pill" data-filter="news">
            {t.home.news}
          </button>
          <button type="button" class="filter-pill" data-filter="column">
            {t.home.columns}
          </button>
          <button type="button" class="filter-pill" data-filter="culture">
            {t.home.culture}
          </button>
        </div>
      </div>

      {allTags.length > 0 && (
        <div class="search-and-tags">
          <div class="search-box">
            <span class="search-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="post-search"
              class="search-input"
              placeholder={sc.placeholder}
              aria-label={sc.placeholder}
            />
          </div>
          <div class="tag-strip">
            {allTags.map((tag) => (
              <button type="button" class="tag-filter-btn" data-tag-filter={tag.toLowerCase()}>
                #{tag}
              </button>
            ))}
          </div>
        </div>
      )}

      <div class="posts-grid" id="posts-grid">
        {allPosts.map((post) => (
          <PostCard post={post} lang={lang} />
        ))}
      </div>

      <p class="empty-state" id="search-empty" hidden>{sc.empty}</p>

      <div class="load-more-wrap" id="load-more-wrap" hidden>
        <button type="button" class="load-more-btn" id="load-more-btn" data-label={sc.loadMore}>
          {sc.loadMore}
        </button>
      </div>
    </div>
  </section>

  <NewsletterBox lang={lang} />
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll('[data-filter]');
  const tagBtns = document.querySelectorAll('[data-tag-filter]');
  const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
  const emptyEl = document.getElementById('search-empty');
  const loadMoreWrap = document.getElementById('load-more-wrap');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const cards = Array.from(document.querySelectorAll('#posts-grid .post-card')) as HTMLElement[];

  const PAGE_SIZE = 6;
  let visibleLimit = PAGE_SIZE;
  let activeCategory = 'all';
  let activeTag = '';
  let searchQuery = '';

  function applyFilters() {
    const isFiltering = activeCategory !== 'all' || Boolean(activeTag) || Boolean(searchQuery);
    const matched: HTMLElement[] = [];

    cards.forEach((el) => {
      const cat = el.dataset.category || '';
      const tags = (el.dataset.tags || '').split(',');
      const hay = el.dataset.search || '';
      const matchCat = activeCategory === 'all' || cat === activeCategory;
      const matchTag = !activeTag || tags.includes(activeTag);
      const matchQuery = !searchQuery || hay.includes(searchQuery);

      if (matchCat && matchTag && matchQuery) {
        matched.push(el);
      } else {
        el.style.display = 'none';
      }
    });

    const limit = isFiltering ? matched.length : visibleLimit;
    matched.forEach((el, idx) => {
      el.style.display = idx < limit ? '' : 'none';
    });

    if (emptyEl) emptyEl.hidden = matched.length > 0;

    if (loadMoreWrap && loadMoreBtn) {
      const remaining = matched.length - limit;
      loadMoreWrap.hidden = remaining <= 0;
      if (remaining > 0) {
        const baseLabel = loadMoreBtn.getAttribute('data-label') || 'Load More';
        loadMoreBtn.textContent = `${baseLabel} (+${remaining})`;
      }
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = (btn as HTMLElement).dataset.filter || 'all';
      filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      applyFilters();
    });
  });

  tagBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const clicked = (btn as HTMLElement).dataset.tagFilter || '';
      activeTag = activeTag === clicked ? '' : clicked;
      tagBtns.forEach((b) =>
        b.classList.toggle('is-active', (b as HTMLElement).dataset.tagFilter === activeTag)
      );
      applyFilters();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      visibleLimit += PAGE_SIZE;
      applyFilters();
    });
  }

  applyFilters();
</script>

<style>
  .ticker-bar {
    background: rgba(255, 46, 147, 0.07);
    border-bottom: 1px solid var(--border-subtle);
    padding: 10px 0;
  }

  .ticker-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    overflow: hidden;
  }

  .ticker-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent-pink);
    white-space: nowrap;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-pink);
    box-shadow: 0 0 10px var(--accent-pink);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .ticker-items {
    display: flex;
    gap: 28px;
    overflow-x: auto;
    scrollbar-width: none;
    font-size: 0.84rem;
    color: var(--text-secondary);
  }

  .ticker-items::-webkit-scrollbar {
    display: none;
  }

  .ticker-link {
    white-space: nowrap;
    transition: color var(--transition);
  }

  .ticker-link:hover {
    color: var(--accent-cyan);
  }

  .hero-section {
    padding: 48px 0 36px;
  }

  .hero-intro {
    margin-bottom: 28px;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.6vw, 3.35rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 780px;
  }

  .gradient-text {
    background: linear-gradient(90deg, var(--accent-pink), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .featured-card {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 240, 255, 0.45);
    box-shadow: 0 24px 56px -20px rgba(0, 240, 255, 0.25);
  }

  .featured-media {
    position: relative;
    min-height: 360px;
    overflow: hidden;
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .featured-card:hover .featured-media img {
    transform: scale(1.04);
  }

  .featured-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, var(--bg-surface) 100%);
  }

  .featured-content {
    padding: 36px 36px 34px 28px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }

  .featured-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.05rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }

  .featured-desc {
    color: var(--text-secondary);
    font-size: 0.98rem;
    margin-bottom: 24px;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-top: 18px;
    border-top: 1px solid var(--border-subtle);
  }

  .featured-cta {
    margin-left: auto;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .feed-section {
    padding: 36px 0 24px;
  }

  .filter-bar {
    display: inline-flex;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 4px;
    gap: 4px;
  }

  .filter-pill {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: var(--transition);
  }

  .filter-pill:hover {
    color: var(--text-primary);
  }

  .filter-pill.is-active {
    background: var(--text-primary);
    color: var(--bg-base);
  }

  .search-and-tags {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 26px;
  }

  .search-box {
    position: relative;
    max-width: 420px;
  }

  .search-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.9rem;
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 11px 16px 11px 42px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    outline: none;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  .search-input:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 0 3px var(--accent-cyan-glow);
  }

  .tag-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .empty-state {
    text-align: center;
    padding: 48px 16px;
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 38px;
  }

  .load-more-btn {
    padding: 12px 28px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-hover);
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    transition: var(--transition);
  }

  .load-more-btn:hover {
    border-color: var(--accent-pink);
    box-shadow: 0 10px 28px -12px var(--accent-pink-glow);
    transform: translateY(-2px);
  }

  .tag-filter-btn {
    border: 1px solid var(--border-subtle);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: var(--transition);
  }

  .tag-filter-btn:hover {
    border-color: var(--accent-cyan);
    color: var(--text-primary);
  }

  .tag-filter-btn.is-active {
    background: rgba(0, 240, 255, 0.14);
    border-color: var(--accent-cyan);
    color: #4df6ff;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 980px) {
    .featured-card {
      grid-template-columns: 1fr;
    }

    .featured-media {
      min-height: 260px;
    }

    .featured-gradient {
      background: linear-gradient(180deg, transparent 50%, var(--bg-surface) 100%);
    }

    .featured-content {
      padding: 24px;
    }

    .posts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
