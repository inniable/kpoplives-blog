---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const rawBody = post.body || '';
const hasFullKo = /^<!--\s*ko\s*-->$/im.test(rawBody);
const hasFullJp = /^<!--\s*(jp|ja)\s*-->$/im.test(rawBody);
const hasFullEs = /^<!--\s*es\s*-->$/im.test(rawBody);

const allPosts = (await getCollection('posts'))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formattedDateEn = data.pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const formattedDateKo = data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDateJp = data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedDateEs = data.pubDate.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={data.title} description={data.description} image={data.coverImage}>
  <article class="article-wrapper">
    <header class="article-header container">
      <a href={data.category === 'news' ? '/news' : '/columns'} class="back-link">
        <span class="lang-en">← Back to {data.category === 'news' ? 'News' : 'Columns'}</span>
        <span class="lang-ko">← {data.category === 'news' ? '뉴스' : '영문 칼럼'} 목록으로</span>
        <span class="lang-jp">← {data.category === 'news' ? 'ニュース' : 'コラム'}一覧へ戻る</span>
        <span class="lang-es">← Volver a {data.category === 'news' ? 'Noticias' : 'Columnas'}</span>
      </a>

      <div class="article-badges">
        <span class:list={['badge', `badge--${data.category}`]}>
          {data.category === 'news' ? (
            <>
              <span class="lang-en">News</span>
              <span class="lang-ko">뉴스</span>
              <span class="lang-jp">ニュース</span>
              <span class="lang-es">Noticias</span>
            </>
          ) : (
            <>
              <span class="lang-en">English Column</span>
              <span class="lang-ko">영문 칼럼</span>
              <span class="lang-jp">英語コラム</span>
              <span class="lang-es">Columna</span>
            </>
          )}
        </span>
        {data.tags.map((tag) => (
          <span class="tag-chip">#{tag}</span>
        ))}
      </div>

      <h1 class="article-title">
        <span class="lang-en">{data.title}</span>
        <span class="lang-ko">{data.titleKo}</span>
        <span class="lang-jp">{data.titleJp || data.title}</span>
        <span class="lang-es">{data.titleEs || data.title}</span>
      </h1>

      <p class="article-subtitle">
        <span class="lang-en">{data.description}</span>
        <span class="lang-ko">{data.descriptionKo}</span>
        <span class="lang-jp">{data.descriptionJp || data.description}</span>
        <span class="lang-es">{data.descriptionEs || data.description}</span>
      </p>

      <div class="article-meta-bar">
        <div class="author-info">
          <span class="author-avatar">{data.author.charAt(0)}</span>
          <div>
            <div class="author-name">{data.author}</div>
            <div class="publish-meta">
              <time datetime={data.pubDate.toISOString()}>
                <span class="lang-en">{formattedDateEn}</span>
                <span class="lang-ko">{formattedDateKo}</span>
                <span class="lang-jp">{formattedDateJp}</span>
                <span class="lang-es">{formattedDateEs}</span>
              </time>
              <span>•</span>
              <span>
                <span class="lang-en">{data.readTime}</span>
                <span class="lang-ko">{data.readTimeKo}</span>
                <span class="lang-jp">{data.readTimeJp}</span>
                <span class="lang-es">{data.readTimeEs}</span>
              </span>
            </div>
          </div>
        </div>

        <div class="inline-lang-bar" role="group" aria-label="Article Language">
          <button type="button" class="inline-lang-btn is-active" data-lang-btn="en">
            English
          </button>
          <button type="button" class="inline-lang-btn" data-lang-btn="ko">
            한국어
          </button>
          <button type="button" class="inline-lang-btn" data-lang-btn="jp">
            日本語
          </button>
          <button type="button" class="inline-lang-btn" data-lang-btn="es">
            Español
          </button>
        </div>
      </div>

      <figure class="article-cover">
        <img src={data.coverImage} alt={data.title} />
      </figure>
    </header>

    <div class="article-content container">
      <!-- Korean Executive Summary Box -->
      <aside class="summary-box lang-ko">
        <div class="summary-header">
          <span class="summary-pill">KR SUMMARY</span>
          <span>핵심 요약</span>
        </div>
        <p>{data.summaryKo}</p>
        {!hasFullKo && (
          <div class="summary-note">
            * 이 글의 본문은 영문 원문으로 제공됩니다. 위 요약을 참고하며 아래 영문 기사를 읽어보세요.
          </div>
        )}
      </aside>

      <!-- Japanese Executive Summary Box -->
      {data.summaryJp && (
        <aside class="summary-box lang-jp">
          <div class="summary-header">
            <span class="summary-pill">JP SUMMARY</span>
            <span>記事の要約</span>
          </div>
          <p>{data.summaryJp}</p>
          {!hasFullJp && (
            <div class="summary-note">
              * 本文は英語オリジナルで提供されています。上記の要約とあわせてお読みください。
            </div>
          )}
        </aside>
      )}

      <!-- Spanish Executive Summary Box -->
      {data.summaryEs && (
        <aside class="summary-box lang-es">
          <div class="summary-header">
            <span class="summary-pill">ES SUMMARY</span>
            <span>Resumen</span>
          </div>
          <p>{data.summaryEs}</p>
          {!hasFullEs && (
            <div class="summary-note">
              * El cuerpo completo está disponible en inglés original. Usa este resumen como guía.
            </div>
          )}
        </aside>
      )}

      <!-- Rendered Markdown Content -->
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {allPosts.length > 0 && (
    <section class="related-section container">
      <div class="section-header">
        <div>
          <span class="section-eyebrow">
            <span class="lang-en">KEEP READING</span>
            <span class="lang-ko">함께 읽으면 좋은 글</span>
            <span class="lang-jp">関連記事</span>
            <span class="lang-es">SEGUIR LEYENDO</span>
          </span>
          <h2 class="section-title">
            <span class="lang-en">More on KPOP LIVES</span>
            <span class="lang-ko">다른 최신 소식 & 칼럼</span>
            <span class="lang-jp">KPOP LIVES の他の記事</span>
            <span class="lang-es">Más en KPOP LIVES</span>
          </h2>
        </div>
      </div>

      <div class="related-grid">
        {allPosts.map((item) => (
          <PostCard post={item} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .article-wrapper {
    padding-top: 40px;
  }

  .article-header {
    max-width: 860px;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 24px;
    transition: color var(--transition);
  }

  .back-link:hover {
    color: var(--accent-cyan);
  }

  .article-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .article-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.14;
    letter-spacing: -0.025em;
    margin-bottom: 16px;
  }

  .article-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .article-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 18px 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 32px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent-pink), var(--accent-cyan));
    color: #07070c;
    font-family: var(--font-display);
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  .author-name {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .publish-meta {
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .inline-lang-bar {
    display: inline-flex;
    flex-wrap: wrap;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 4px;
    gap: 4px;
  }

  .inline-lang-btn {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 13px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: var(--transition);
  }

  .inline-lang-btn:hover {
    color: var(--text-primary);
  }

  .inline-lang-btn.is-active {
    background: linear-gradient(135deg, var(--accent-pink), #c91878);
    color: #ffffff;
  }

  .article-cover {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    margin-bottom: 42px;
    aspect-ratio: 16 / 9;
    background: var(--bg-surface);
  }

  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-content {
    max-width: 740px;
  }

  .summary-box {
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.08), rgba(255, 46, 147, 0.08));
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: var(--radius-md);
    padding: 22px 24px;
    margin-bottom: 34px;
  }

  .summary-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--text-primary);
  }

  .summary-pill {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
    background: var(--accent-cyan);
    color: #07070c;
    font-weight: 700;
  }

  .summary-box p {
    color: #e6e6f2;
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .summary-note {
    margin-top: 12px;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .related-section {
    margin-top: 84px;
    padding-top: 52px;
    border-top: 1px solid var(--border-subtle);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
