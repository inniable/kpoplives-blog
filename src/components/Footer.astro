---
import { type Lang, UI, localizePath } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">KPOP<span>LIVES</span></div>
      <p class="footer-desc">{t.footer.desc}</p>
    </div>

    <div class="footer-columns">
      <div class="footer-col">
        <a href={localizePath(lang, '/news')}>{t.nav.news}</a>
        <a href={localizePath(lang, '/columns')}>{t.nav.columns}</a>
        <a href={localizePath(lang, '/about')}>{t.footer.guide}</a>
      </div>
      <div class="footer-col">
        <a href={localizePath(lang, '/privacy')}>{t.footer.privacy}</a>
        <a href={localizePath(lang, '/terms')}>{t.footer.terms}</a>
        <a href={localizePath(lang, '/contact')}>{t.footer.contact}</a>
      </div>
      <div class="footer-col">
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">Sitemap</a>
        <a href="/llms.txt">llms.txt</a>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} KPOP LIVES. All rights reserved.</span>
    <span class="footer-tech">Astro • Cloudflare Workers • EN / KR / JP / ES</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--border-subtle);
    background: rgba(11, 11, 18, 0.85);
    padding: 52px 0 32px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 36px;
    flex-wrap: wrap;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .footer-logo span {
    background: linear-gradient(90deg, var(--accent-pink), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer-desc {
    max-width: 400px;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .footer-columns {
    display: flex;
    gap: 44px;
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .footer-col a:hover {
    color: var(--accent-cyan);
  }

  .footer-bottom {
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
</style>
