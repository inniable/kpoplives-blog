---
/**
 * CLS-safe Google AdSense Slot Component
 *
 * Stays completely invisible until PUBLIC_ADSENSE_CLIENT (e.g. ca-pub-XXXXXXXXXXXXXXXX)
 * is configured in your Cloudflare environment variables.
 */
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'in-article';
  label?: string;
}

const { slotId = '', format = 'horizontal', label = 'Advertisement' } = Astro.props;
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

{adClient && slotId && (
  <aside class:list={['ad-slot', `ad-slot--${format}`]} aria-label={label}>
    <span class="ad-label">{label}</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={adClient}
      data-ad-slot={slotId}
      data-ad-format={format === 'in-article' ? 'fluid' : 'auto'}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (window.adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </aside>
)}

<style>
  .ad-slot {
    margin: 32px auto;
    padding: 12px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    text-align: center;
    overflow: hidden;
  }

  .ad-slot--horizontal {
    min-height: 110px;
  }

  .ad-slot--rectangle {
    min-height: 270px;
  }

  .ad-slot--in-article {
    min-height: 140px;
  }

  .ad-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }
</style>
