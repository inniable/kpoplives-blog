---
import {
  type Lang,
  LANGS,
  UI,
  localizePath,
  stripLangPrefix,
} from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const baseRoute = stripLangPrefix(Astro.url.pathname);

const navItems = [
  { route: '/', label: t.nav.home },
  { route: '/news', label: t.nav.news },
  { route: '/columns', label: t.nav.columns },
  { route: '/culture', label: t.nav.culture },
  { route: '/about', label: t.nav.about },
];

const isActive = (route: string) =>
  route === '/' ? baseRoute === '/' : baseRoute.startsWith(route);

const langLabels: Record<Lang, string> = {
  en: 'EN',
  ko: 'KR',
  jp: 'JP',
  es: 'ES',
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href={localizePath(lang, '/')} class="brand" aria-label="KPOP LIVES Home">
      <span class="brand-dot"></span>
      <span class="brand-text">KPOP<span class="brand-accent">LIVES</span></span>
    </a>

    <nav class="main-nav" aria-label="Primary Navigation">
      {navItems.map((item) => (
        <a
          href={localizePath(lang, item.route)}
          class:list={['nav-link', { 'is-active': isActive(item.route) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <nav class="lang-switch" aria-label="Language Switcher" translate="no">
        {LANGS.map((code) => (
          <a
            href={localizePath(code, baseRoute)}
            class:list={['lang-btn', { 'is-active': lang === code }]}
            aria-current={lang === code ? 'page' : undefined}
            hreflang={code === 'jp' ? 'ja' : code}
          >
            {langLabels[code]}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background: rgba(7, 7, 12, 0.78);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.03em;
  }

  .brand-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-pink);
    box-shadow: 0 0 12px var(--accent-pink), 0 0 24px var(--accent-pink-glow);
  }

  .brand-accent {
    background: linear-gradient(90deg, var(--accent-pink), var(--accent-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-left: 2px;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    transition: var(--transition);
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-link.is-active {
    color: var(--text-primary);
    background: rgba(255, 46, 147, 0.14);
    box-shadow: inset 0 0 0 1px rgba(255, 46, 147, 0.35);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 3px;
    gap: 2px;
  }

  .lang-btn {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    transition: var(--transition);
  }

  .lang-btn:hover {
    color: var(--text-primary);
  }

  .lang-btn.is-active {
    background: linear-gradient(135deg, var(--accent-pink), #c91878);
    color: #ffffff;
    box-shadow: 0 0 14px var(--accent-pink-glow);
  }

  @media (max-width: 780px) {
    .header-inner {
      height: auto;
      padding-top: 14px;
      padding-bottom: 14px;
      flex-wrap: wrap;
    }

    .main-nav {
      order: 3;
      width: 100%;
      overflow-x: auto;
      padding-top: 6px;
    }

    .nav-link {
      white-space: nowrap;
      font-size: 0.85rem;
      padding: 6px 12px;
    }
  }
</style>
