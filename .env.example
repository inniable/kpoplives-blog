# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default translation model (default: gemini-4-hydrogen)
# GEMINI_TRANSLATE_MODEL=gemini-4-hydrogen

# Optional: Enable Google AdSense once approved (set in Cloudflare Workers Env Vars too)
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
